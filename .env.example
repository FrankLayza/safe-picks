# Safe Picks environment template
# Copy to .env for local development. Never commit the populated file.

# Required now: create a bot with BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=

# Required when the Telegram bot calls the forecasting service.
FORECASTING_SERVICE_URL=http://localhost:8000

# Optional development allowlist. Comma-separated Telegram numeric user IDs.
# Leave empty to allow all users during local development.
ALLOWED_TELEGRAM_USER_IDS=

# Optional application settings.
NODE_ENV=development
LOG_LEVEL=info

# Forecasting service settings used by the local uvicorn command or future runner.
FORECASTING_HOST=127.0.0.1
FORECASTING_PORT=8000

# Phase 3 provider settings. Keep credentials empty until the account and licence gates are approved.
DATABASE_URL=
FOOTBALL_DATA_BASE_URL=https://www.football-data.co.uk
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
ODDS_API_KEY=
ODDS_API_SPORT=soccer_epl
ODDS_API_REGIONS=eu
ODDS_API_MARKETS=h2h,totals
ODDS_API_FORMAT=decimal
RAW_DATA_STORAGE_URL=
RAW_DATA_STORAGE_ACCESS_KEY=
RAW_DATA_STORAGE_SECRET_KEY=
RAW_DATA_ROOT=data/raw
FOOTBALL_DATA_LEAGUE=E0
FOOTBALL_DATA_SEASON=2526
INGESTION_MAX_SNAPSHOT_AGE_DAYS=7
# Leave empty to audit optional statistics without rejecting the manifest.
INGESTION_MAX_OPTIONAL_MISSING_FRACTION=

# Planned Phase 7+ experiment and operations settings.
MODEL_REGISTRY_URL=
PAPER_TRADE_DEFAULT_STAKE=1.00
ODDS_MAX_AGE_MINUTES=15
